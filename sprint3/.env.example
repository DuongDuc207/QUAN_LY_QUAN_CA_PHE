# --- SQL Server ---
# Ten instance xem trong SQL Server Configuration Manager / Windows Services.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=QuanLyCaPhe
DB_DRIVER=ODBC Driver 17 for SQL Server
# Bo trong neu dung Windows Authentication
DB_USER=
DB_PASSWORD=
DB_TRUSTED=yes

# --- Flask ---
